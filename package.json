{
  "name": "adhdice-clean-prototype",
  "version": "7.11.61",
  "private": true,
  "scripts": {
    "dev": "node --experimental-strip-types ./scripts/dev-server.mjs",
    "build": "next build",
    "build:ios": "CAPACITOR_BUILD=1 npm run build && npx cap sync ios",
    "ios:device": "npm run build:ios && npx cap run ios --target 00008150-000948880AEA401C --scheme ADHDice --no-sync",
    "start": "next start",
    "lint": "eslint",
    "audit:text-buttons": "node ./scripts/audit-text-buttons.mjs",
    "lint:taskapp-wave": "eslint src/components/task-app.tsx src/lib/profile-store.ts src/lib/task-db-compat.ts src/lib/task-focus-days.ts src/lib/task-formatting.ts src/lib/task-input-parsing.ts src/lib/task-repeat.ts test/task-refactor-helpers.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:taskapp-wave": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --import ./test/register-alias.mjs --experimental-strip-types --test test/*.test.ts",
    "test:records-reconciliation-nonblocking": "node --import ./test/register-alias.mjs --experimental-strip-types --test test/records-reconciliation-timeout.test.ts",
    "test:records-reconciliation-temp-spill": "node --import ./test/register-alias.mjs --experimental-strip-types --test test/records-reconciliation-timeout.test.ts",
    "test:records-chunked-reconciliation": "node --import ./test/register-alias.mjs --experimental-strip-types --test test/records-reconciliation-timeout.test.ts",
    "test:records-rpc-contract": "node --import ./test/register-alias.mjs --experimental-strip-types --test test/records-rpc-contract.test.ts",
    "test:records-sql-compatibility": "node --import ./test/register-alias.mjs --experimental-strip-types --test test/records-sql-compatibility.test.ts",
    "test:task-state-sql-compile": "node --import ./test/register-alias.mjs --experimental-strip-types --test test/task-state-command-sql-compile.test.ts",
    "test:taskapp-wave": "node --import ./test/register-alias.mjs --experimental-strip-types --test test/task-helper-modules.test.ts test/task-refactor-helpers.test.ts test/task-action-hooks-smoke.test.ts"
  },
  "dependencies": {
    "@capacitor/barcode-scanner": "^3.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.105.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
